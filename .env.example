# ============================================================
# Peopole AI — Earth Solutions Visa Zone
# Environment Variable Template
# ============================================================
#
# NEVER commit real secrets.
# Local development:
#   copy .env.example to .env.local
#
# Vercel:
#   configure variables in Project Settings → Environment Variables
#
# ============================================================

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------

NODE_ENV=development
PORT=3000

# ------------------------------------------------------------
# AI Provider
# ------------------------------------------------------------

GROQ_API_KEY=REPLACE_WITH_GROQ_API_KEY

# ------------------------------------------------------------
# CORS / Origin Protection
# ------------------------------------------------------------

# Set this to the exact deployed origin and configure the same trusted origin in Neon Auth.
# Localhost is disabled on the current default Neon Auth branch.
# ALLOWED_ORIGIN=http://localhost:3000

# ------------------------------------------------------------
# Web Push / VAPID
# ------------------------------------------------------------

VAPID_PUBLIC=REPLACE_WITH_VAPID_PUBLIC_KEY
VAPID_PRIVATE=REPLACE_WITH_VAPID_PRIVATE_KEY
VAPID_EMAIL=mailto:admin@earthsolutions.com.bd

# ------------------------------------------------------------
# Neon Auth + PostgreSQL
# ------------------------------------------------------------

# Server-side only. Use the dedicated earth_app_runtime login; never expose it to browser code.
DATABASE_URL=REPLACE_WITH_NEON_RUNTIME_LOGIN_URL

# Separate server-side credential for privileged admin repositories only.
# Use the dedicated earth_app_admin login; never use this for customer-facing queries.
ADMIN_DATABASE_URL=REPLACE_WITH_NEON_ADMIN_LOGIN_URL

# Required for signed guest sessions. Generate at least 32 random bytes.
# Keep stable across instances and deployments; rotate only with a planned guest-session invalidation.
GUEST_SESSION_SECRET=REPLACE_WITH_32_BYTE_OR_LONGER_RANDOM_SECRET

# Managed Better Auth endpoints for this Neon branch.
NEON_AUTH_BASE_URL=https://ep-late-shadow-biek3knt.neonauth.c-5.ap-southeast-1.aws.neon.tech/peopole_ai/auth
NEON_AUTH_JWKS_URL=https://ep-late-shadow-biek3knt.neonauth.c-5.ap-southeast-1.aws.neon.tech/peopole_ai/auth/.well-known/jwks.json

# Must exactly match a trusted origin configured in Neon Auth.
# Use the deployed application origin, not a preview URL.
ALLOWED_ORIGIN=https://earth-solutions-ecg.vercel.app

# Neon Auth email delivery is configured in Neon (standard SMTP), not in browser code.
# Resend SMTP: host smtp.resend.com, port 465, username resend.
# Store the Resend API key only in Neon Auth's SMTP password field; never commit it.

# ------------------------------------------------------------
# Optional application environment metadata
# ------------------------------------------------------------

APP_ENV=development

# One-time migration only; never configure these on a deployed app.
# LEGACY_SOURCE_DATABASE_URL=NEON_STAGING_BRANCH_CONNECTION_STRING
# CONFIRM_LEGACY_TRANSFER=1
