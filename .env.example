# ═══════════════════════════════════════════════════════════════
# Peopole AI — Complete Environment Variables
# Copy to .env locally. On Render: set in Environment tab.
# On Vercel: Project → Settings → Environment Variables.
# ═══════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────
# 1. AI — Groq LLaMA 70B (REQUIRED)
#    https://console.groq.com/ → API Keys
# ─────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────────────────────
# 2. SESSION STORE — Upstash Redis (Step 5)
#    https://console.upstash.com → Create DB → REST API tab
#    Free tier: 10,000 commands/day
# ─────────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=redis-cli --tls -u redis://default:gQAAAAAAAYjBAAIgcDE5YTEzY2NmMjBhYTc0YjQxYjBlMjkzZjNjZmY3MmU3NA@enhanced-impala-100545.upstash.io:6379
UPSTASH_REDIS_REST_TOKEN=gQAAAAAAAYjBAAIgcDE5YTEzY2NmMjBhYTc0YjQxYjBlMjkzZjNjZmY3MmU3NA

# ─────────────────────────────────────────────────────────────
# 3. ADMIN PANEL (Step 3 hardening)
#    Change this — it is printed to logs if left as default
#    Min 16 chars, use a password manager to generate
# ─────────────────────────────────────────────────────────────
ADMIN_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD_MIN16CHARS

# ─────────────────────────────────────────────────────────────
# 4. JWT AUTH — for user login/register (Step 2)
#    Generate secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#    ACCESS_TOKEN expires fast (15m); REFRESH_TOKEN lasts longer (7d)
# ─────────────────────────────────────────────────────────────
JWT_SECRET=yjyE593W7PXp0IjTJSwro7Rt0aP4Ex8LpkHzlr3QSV4
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─────────────────────────────────────────────────────────────
# 5. DATABASE — Supabase PostgreSQL (Step 1)
#    https://supabase.com → Project → Settings → Database
#    Use the "Transaction" pooler URL (port 6543) for Express
# ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:6543/postgres
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=eyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
SUPABASE_SERVICE_ROLE_KEY=eyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ─────────────────────────────────────────────────────────────
# 6. WEB PUSH — VAPID keys for push notifications
#    Generate ONCE with: npx web-push generate-vapid-keys
#    Never regenerate — existing subscribers will break
# ─────────────────────────────────────────────────────────────
VAPID_PUBLIC=YOUR_VAPID_PUBLIC_KEY
VAPID_PRIVATE=YOUR_VAPID_PRIVATE_KEY
VAPID_EMAIL=mailto:admin@earthsolutions.com.bd

# ─────────────────────────────────────────────────────────────
# 7. CORS — restrict API to your deployed frontend
#    Comma-separate multiple origins if needed
# ─────────────────────────────────────────────────────────────
ALLOWED_ORIGIN=https://earth-solutions-ecg.vercel.app

# ─────────────────────────────────────────────────────────────
# 8. SERVER
# ─────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
